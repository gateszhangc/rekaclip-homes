{
  "name": "ai-outfit-generator",
  "version": "2.6.0",
  "private": true,
  "author": "idoubi",
  "homepage": "https://www.qwenimageedit.club",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "cross-env NODE_NO_WARNINGS=1 node scripts/dev/next-runtime.mjs dev web",
    "dev:3000": "bash scripts/dev-next-with-proxy.sh",
    "dev:web": "cross-env NODE_NO_WARNINGS=1 node scripts/dev/next-runtime.mjs dev web",
    "dev:stable": "cross-env NODE_NO_WARNINGS=1 node scripts/dev/next-runtime.mjs dev web",
    "dev:playwright": "cross-env NODE_NO_WARNINGS=1 NEXT_PUBLIC_AUTH_DISABLED=true node scripts/dev/next-runtime.mjs dev playwright",
    "dev:turbo": "cross-env NODE_NO_WARNINGS=1 node scripts/dev/next-runtime.mjs dev web --turbopack",
    "dev:reset": "node scripts/dev/reset.mjs",
    "build": "fumadocs-mdx && cross-env NODE_NO_WARNINGS=1 node scripts/dev/next-runtime.mjs build build",
    "start": "cross-env NODE_NO_WARNINGS=1 node .next/build/standalone/server.js",
    "lint": "next lint",
    "analyze": "cross-env ANALYZE=true npm run build",
    "docker:build": "docker build -f Dockerfile -t shipany-template-one:latest .",
    "db:generate": "npx drizzle-kit generate --config=src/db/config.ts",
    "db:migrate": "npx drizzle-kit migrate --config=src/db/config.ts",
    "db:studio": "npx drizzle-kit studio --config=src/db/config.ts",
    "db:push": "npx drizzle-kit push --config=src/db/config.ts",
    "postinstall": "fumadocs-mdx",
    "test": "npm run test:runtime && npm run test:backend && vitest run && playwright test",
    "test:backend": "node --import tsx --test backend/src/routes/*.test.ts backend/src/services/*.test.ts",
    "test:runtime": "node --import tsx --test scripts/dev/*.node-test.mjs",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:browser:real-deploy": "tsx scripts/browser-debug/test-real-deploy.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "i18n:translate": "tsx scripts/i18n/translate-locales.ts",
    "i18n:validate": "tsx scripts/i18n/validate-locales.ts"
  },
